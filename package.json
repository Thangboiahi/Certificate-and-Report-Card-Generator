{
  "name": "certificate-and-report-card-generator",
  "version": "0.1.0",
  "description": "Bulk document, card, certificate and report generation SaaS (browser-side PDF engine).",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-v6 'vitest run --config vitest.emulator.config.mts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "browser-image-compression": "2.0.2",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "firebase-admin": "14.5.0",
    "framer-motion": "14.6.0",
    "jszip": "3.10.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.2.0",
    "react-easy-crop": "6.2.5",
    "regenerator-runtime": "0.14.1",
    "resend": "6.35.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
