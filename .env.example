# Copy to `.env.local` for local development. Never commit real values.
#
# Until a live Firebase project exists, local development runs against the Firebase emulators
# (`npx firebase emulators:start --only auth,firestore --project demo-v6`). Placeholder values:
#   FIREBASE_PROJECT_ID=demo-v6
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# A `demo-` project id guarantees nothing ever reaches a real Google project.
# On Cloud Run these are set as service environment variables (see docs/ARCHITECTURE.md).

# ── Firebase (server) ────────────────────────────────────────────────────────────────────────────
# Project whose ID tokens the API routes accept. Required in every deployed environment.
FIREBASE_PROJECT_ID=

# Public origin of the app (e.g. https://app.example.in). Used by /api/auth/session and the dispatch
# routes to check that requests come from this site, and REQUIRED for dispatch: claim links in
# WhatsApp messages and emails are built from it (never from request headers).
APP_ORIGIN=

# LOCAL TESTING ONLY. Lets a production build talk to the Firebase emulators. With emulator
# variables set, unsigned tokens are accepted, so this is refused on Cloud Run regardless.
ALLOW_FIREBASE_EMULATOR=false

# ── Image proxy (/api/proxy-image) ───────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY. Lets the proxy answer without a Firebase ID token. It is ignored (and the
# proxy refuses to start serving) when the app runs on Cloud Run.
IMAGE_PROXY_ALLOW_ANONYMOUS=false

# Largest image the proxy will relay, in bytes (default 8 MiB).
IMAGE_PROXY_MAX_BYTES=8388608
# Total time budget for one upstream fetch including redirects, in milliseconds (default 15 s).
IMAGE_PROXY_TIMEOUT_MS=15000
# How long the browser may cache a proxied image, in seconds (default 10 min).
IMAGE_PROXY_CACHE_SECONDS=600

# ── Dispatch (/api/dispatch/whatsapp, /api/dispatch/email) ────────────────────────────────────────
# Each channel answers 503 until its variables are set. Secrets: set them as Cloud Run secrets.
# Meta WhatsApp Cloud API: a system-user access token, the sender's phone number id, and the name
# of an APPROVED Utility template with body parameters {{1}} name, {{2}} issuer, {{3}} claim link,
# {{4}} expiry date.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLAIM_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Graph API root (testing only: point it at a local mock). Default https://graph.facebook.com/v23.0
WHATSAPP_API_BASE_URL=
# Resend: API key and a sender on a domain verified in Resend, e.g. Certificates <claims@example.in>
RESEND_API_KEY=
RESEND_FROM=

# ── Claim-token purge (/api/cron/purge-claim-tokens) ─────────────────────────────────────────────
# Shared secret (32+ random characters) that Cloud Scheduler sends as `Authorization: Bearer …`
# once a day. The route answers 503 until it is set. Store it as a secret.
CRON_SECRET=

# ── Payments: pay-to-claim escrow (/api/checkout, /api/webhooks/razorpay) — ADR-028 ──────────────
# Razorpay API keys (test keys first: rzp_test_…). Without them paid claims answer 503 and the claim
# page says online payment is not available. Route must be enabled on the account. Secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret of the webhook endpoint created in Dashboard → Webhooks for
# https://<APP_ORIGIN>/api/webhooks/razorpay with the event `payment.captured`. Without it the webhook
# answers 503 and paid claims are only settled by the status poll and the sweep. Secret.
RAZORPAY_WEBHOOK_SECRET=
# REST root (testing only: point it at a local mock). Default https://api.razorpay.com/v1
RAZORPAY_API_BASE_URL=
# Pricing — PLACEHOLDERS until pricing is decided (PLAN E12). Malformed values disable payments.
# Platform fee on the claim fee, in basis points (1000 = 10 %, at most 5000). Default 1000.
PLATFORM_FEE_BPS=
# Price of the optional "AI enrichment" add-on in paise (100–100000). Unset = not offered (default:
# switch it on only once Phase 9 delivers what it sells).
AI_ENRICHMENT_FEE_PAISE=
# Days the institution's share is held in Razorpay before it settles (escrow; 0–30). Default 7.
ESCROW_HOLD_DAYS=
# The reconciliation sweep POST /api/cron/reconcile-payments uses CRON_SECRET (above); schedule it
# every 15 minutes.
