# Copy to `.env.local` for local development. Never commit real values.
#
# Until a live Firebase project exists, local development runs against the Firebase emulators
# (`npx firebase emulators:start --only auth,firestore --project demo-v6`). Placeholder values:
#   FIREBASE_PROJECT_ID=demo-v6
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# A `demo-` project id guarantees nothing ever reaches a real Google project.
# On Cloud Run these are set as service environment variables (see docs/ARCHITECTURE.md).

# ── Firebase (server) ────────────────────────────────────────────────────────────────────────────
# Project whose ID tokens the API routes accept. Required in every deployed environment.
FIREBASE_PROJECT_ID=

# Public origin of the app (e.g. https://app.example.in), used by /api/auth/session to check that
# sign-in requests come from this site. Only needed when a proxy rewrites the Host header.
APP_ORIGIN=

# LOCAL TESTING ONLY. Lets a production build talk to the Firebase emulators. With emulator
# variables set, unsigned tokens are accepted, so this is refused on Cloud Run regardless.
ALLOW_FIREBASE_EMULATOR=false

# ── Image proxy (/api/proxy-image) ───────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY. Lets the proxy answer without a Firebase ID token. It is ignored (and the
# proxy refuses to start serving) when the app runs on Cloud Run.
IMAGE_PROXY_ALLOW_ANONYMOUS=false

# Largest image the proxy will relay, in bytes (default 8 MiB).
IMAGE_PROXY_MAX_BYTES=8388608
# Total time budget for one upstream fetch including redirects, in milliseconds (default 15 s).
IMAGE_PROXY_TIMEOUT_MS=15000
# How long the browser may cache a proxied image, in seconds (default 10 min).
IMAGE_PROXY_CACHE_SECONDS=600
